// use prisma-8

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("USER")
  active       Boolean  @default(true)
  createdAt    TimestamptzJsDate  @default(now())
  updatedAt    TimestamptzJsDate  @default(now())
}


model Booking {
  id                      Int                @id @default(autoincrement())
  reference               String             @unique
  customerName            String
  customerEmail           String?
  customerPhone           String
  pickup                  String
  destination             String
  tripType                String
  journeyDate             TimestamptzJsDate
  journeyTime             String
  returnDate              TimestamptzJsDate?
  returnTime              String?
  vehicleName             String
  passengerCount          Int
  luggageCount            Int                @default(0)
  specialInstructions     String?
  status                  String             @default("PENDING")
  assignedDriverId        Int?
  pickupLat               Float?
  pickupLng               Float?
  destinationLat          Float?
  destinationLng          Float?
  distanceMeters          Float?
  durationSeconds         Float?

  // Payment values: AUD cents
  paymentMethod           String             @default("PAY_DRIVER")
  paymentStatus           String             @default("PENDING")
  amountCents             Int?
  stripeCheckoutSessionId String?            @unique
  stripePaymentIntentId   String?
  paidAt                  TimestamptzJsDate?

  createdAt               TimestamptzJsDate  @default(now())
  updatedAt               TimestamptzJsDate  @default(now())
}

model Vehicle {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  capacity        Int      @default(4)
  luggageCapacity Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}


model Driver {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ServiceType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ContactEnquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  message   String
  status    String   @default("NEW")
  
  createdAt    TimestamptzJsDate  @default(now())
  updatedAt    TimestamptzJsDate  @default(now())
}